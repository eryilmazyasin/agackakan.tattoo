# Public canonical origin. Set before the production build; leave empty for local development.
# The confirmed domain is also the code default; development remains noindex.
SITE_URL=https://agackakantattoo.com
# Set false for staging or non-Vercel preview deployments. Public builds default to true.
SEO_INDEXABLE=true
# Optional ownership tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
